# ---------------------------------------------------------------------------
# Passport Photo Studio — backend configuration
# Copy this file to `.env` and adjust. NEVER commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Port / host for the backend (it also serves ../frontend).
PORT=8787
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# ClearBackdrop
# Docs: https://clearbackdrop.com/api
#
# The standard model is FREE and needs NO api key and NO signup, so by default
# nothing has to be configured here. Only set CLEARBACKDROP_BRIA_KEY if you were
# granted access to the premium BRIA RMBG-2.0 model (it is sent as the
# `X-Bria-Key` request header and never reaches the browser).
#
# IMPORTANT: use the non-www host. The www host 301-redirects and the POST body
# is dropped by the redirect.
# ---------------------------------------------------------------------------
CLEARBACKDROP_BASE=https://clearbackdrop.com
CLEARBACKDROP_REMOVE_PATH=/api/v1/remove-background
CLEARBACKDROP_QUOTA_PATH=/api/v1/quota

# Optional — leave empty for the free standard model.
CLEARBACKDROP_BRIA_KEY=

# 'binary' streams the PNG straight back (fastest, default).
# 'json' asks ClearBackdrop for metadata and then downloads result_url.
CLEARBACKDROP_RESPONSE_MODE=binary

# ClearBackdrop documents a 15MB upload limit.
MAX_UPLOAD_MB=15

# Upstream timeout in ms. Background removal normally takes a few seconds;
# the BRIA model can take 20-25s.
CLEARBACKDROP_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# CORS — only needed when the frontend is served from a DIFFERENT origin
# (e.g. Live Server on :5500 or a separate static host). Leave empty to allow
# any origin during development, or pin it down for production.
# Multiple origins: http://localhost:5500,https://studio.example.com
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=

# ---------------------------------------------------------------------------
# Dev / test only. When 1, the backend answers /api/remove-background with a
# locally generated transparent PNG and never calls ClearBackdrop.
# ---------------------------------------------------------------------------
CLEARBACKDROP_MOCK=0

# Dev / test only. When 1, a request may carry `simulate=upstream_error|
# rate_limit|timeout|bad_response` to exercise the error paths (Retry/Cancel in
# the UI). ALWAYS leave this at 0 in production.
ALLOW_SIMULATE=0

# Optional override — where index.html lives (defaults to ../frontend).
# FRONTEND_DIR=
