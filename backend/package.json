{
  "name": "passport-photo-studio-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend proxy for Passport Photo Studio — relays cropped images to the ClearBackdrop background-removal API and serves the frontend.",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "mock": "CLEARBACKDROP_MOCK=1 node server.js",
    "mock:windows": "set CLEARBACKDROP_MOCK=1 && node server.js",
    "test": "node test/smoke.test.js",
    "test:frontend": "node test/frontend.test.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "multer": "^2.0.1"
  },
  "devDependencies": {
    "canvas": "^2.11.2",
    "jsdom": "^24.1.3"
  },
  "license": "MIT"
}
